<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= titulek %></title>
    <link rel="stylesheet" href="/style.css" />
</head>
<body>
    <%- include('./partials/header') %>

    <main>
        <h1>Přihlášení uživatele</h1>
        <form action="/users/sign" method="post">
            <label for="jmeno">Jméno:</label><br />
            <input type="text" id="jmeno" name="jmeno" placeholder="Jméno..." required /><br />
            <label for="heslo">Heslo:</label><br />
            <input type="password" id="heslo" name="heslo" placeholder="Heslo..." required /><br />
            <button type="submit">Vstoupit</button>
        </form>
    </main>

    <%- include('./partials/footer') %>
</body>
</html>